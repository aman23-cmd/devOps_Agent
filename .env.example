# ═══════════════════════════════════════════════════════════════
#  DevOps Pipeline Agent — Environment Variables
#  Copy this file to .env and fill in real values
# ═══════════════════════════════════════════════════════════════

# ── AI / LLM ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── GitHub ────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ── Slack ─────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://devops:devops@postgres:5432/devops_agent

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Cloud Providers (optional — leave blank to skip) ─────────
GCP_PROJECT_ID=
AWS_REGION=
AWS_LOG_GROUP=

# ── PagerDuty (optional — for escalation alerts) ─────────────
PAGERDUTY_ROUTING_KEY=

# ── Application ──────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
MAX_LOG_LINES=5000
AUTOGEN_MAX_ROUNDS=15
